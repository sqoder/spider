# Copy this file to .env and fill in the values you need.
# None of these are required for YtdlpYouTubeCrawler / VisibleYouTubeCrawler /
# PlaywrightYouTubeCrawler — those work out of the box.

# Only needed if you want to use the official Data API v3 client
# (YouTubeCrawler class). Get a key at:
#   https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=AIza...

# Optional: HTTP/SOCKS proxy URL if your IP is rate-limited by YouTube.
# Example formats:
#   http://user:pass@host:port
#   socks5://host:port
# PROXY_URL=

# Optional: path to a Netscape-format cookies file, exported from your logged-in
# browser. Helps with age-restricted or region-restricted videos.
# YOUTUBE_COOKIES_FILE=./youtube_cookies.txt
