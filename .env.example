# ============================================
# GlobalMediaCrawler Environment Configuration
# ============================================

# Application
APP_NAME=GlobalMediaCrawler
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
AUTO_CREATE_TABLES=false
ENABLED_PLATFORMS=youtube,reddit

CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://crawler:crawler_pass@localhost:5432/global_media_crawler
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Media Storage
MEDIA_STORAGE_PATH=./media
MEDIA_MAX_SIZE_MB=500

# ============================================
# Platform API Keys
# ============================================

# YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000

# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=GlobalMediaCrawler/1.0

# Experimental platforms
TIKTOK_COOKIES_FILE=
INSTAGRAM_COOKIES_FILE=
X_ACCOUNTS_FILE=

# ============================================
# Rate Limiting
# ============================================
DEFAULT_RATE_LIMIT=30
DEFAULT_RATE_PERIOD=60
YOUTUBE_RATE_LIMIT=50
YOUTUBE_RATE_PERIOD=60
REDDIT_RATE_LIMIT=90
REDDIT_RATE_PERIOD=60
TIKTOK_RATE_LIMIT=20
TIKTOK_RATE_PERIOD=60

# ============================================
# Proxy (optional)
# ============================================
PROXY_URL=
PROXY_ROTATION=false
